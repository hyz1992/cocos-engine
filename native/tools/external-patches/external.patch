diff --git a/sources/enoki/half.h b/sources/enoki/half.h
index fd2fbb66..80991755 100644
--- a/sources/enoki/half.h
+++ b/sources/enoki/half.h
@@ -20,9 +20,25 @@ struct half;
 NAMESPACE_END(enoki)
 
 NAMESPACE_BEGIN(std)
-template<> struct is_floating_point<enoki::half> : true_type { };
-template<> struct is_arithmetic<enoki::half> : true_type { };
-template<> struct is_signed<enoki::half> : true_type { };
+/*
+ * Xcode 16+/new libc++ marks standard traits like std::is_floating_point,
+ * std::is_arithmetic and std::is_signed as no-specialization entities.
+ * Specializing them here triggers:
+ *   "Users are not allowed to specialize this standard library entity".
+ *
+ * Keep compatibility by only specializing libc++'s internal floating-point
+ * hook for enoki::half. std::is_arithmetic then becomes true through libc++
+ * implementation (is_integral || is_floating_point).
+ *
+ * Keep the original 3 lines below as comments for reference:
+ * template<> struct is_floating_point<enoki::half> : true_type { };
+ * template<> struct is_arithmetic<enoki::half> : true_type { };
+ * template<> struct is_signed<enoki::half> : true_type { };
+ */
+// template<> struct is_floating_point<enoki::half> : true_type { };
+// template<> struct is_arithmetic<enoki::half> : true_type { };
+// template<> struct is_signed<enoki::half> : true_type { };
+template<> struct __libcpp_is_floating_point<enoki::half> : true_type { };
 NAMESPACE_END(std)
 
 NAMESPACE_BEGIN(enoki)
